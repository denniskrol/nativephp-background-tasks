{
  "name": "projectmata/mobile-background-tasks",
  "description": "Background task scheduling plugin for NativePHP Mobile — wraps Laravel's scheduler and runs tasks via WorkManager (Android) and BGTaskScheduler (iOS).",
  "type": "nativephp-plugin",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Projectmata\\MobileBackgroundTasks\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Projectmata\\MobileBackgroundTasks\\MobileBackgroundTasksServiceProvider"
      ]
    },
    "nativephp": {
      "manifest": "nativephp.json"
    }
  },
  "require": {
    "php": "^8.1",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  }
}
